# Copiar este archivo a ".env" (mismo folder) y completar con tus credenciales reales.
# El archivo ".env" NUNCA debe subirse al repositorio (ya está en .gitignore).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_usuario@dominio.com
SMTP_PASSWORD=tu_password_o_app_password
SMTP_FROM=tu_usuario@dominio.com
SMTP_USE_TLS=true
